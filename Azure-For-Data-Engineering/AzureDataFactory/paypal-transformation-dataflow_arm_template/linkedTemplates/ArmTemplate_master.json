{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "adf-azde-lab-ci-001"
        },
        "AzureBlobStorage1_connectionString": {
            "type": "secureString",
            "metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
        },
        "ls_azuresql_password": {
            "type": "secureString",
            "metadata": "Secure string for 'password' of 'ls_azuresql'"
        },
        "LS_ADLSGen2_Blob_connectionString": {
            "type": "secureString",
            "metadata": "Secure string for 'connectionString' of 'LS_ADLSGen2_Blob'"
        },
        "LS_AzureSQL_DB_password": {
            "type": "secureString",
            "metadata": "Secure string for 'password' of 'LS_AzureSQL_DB'"
        },
        "ls_azuresql_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "sql-azde-lab-ci-001.database.windows.net"
        },
        "ls_azuresql_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "free-sql-db-azde-lab"
        },
        "ls_azuresql_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "azure_lab_user"
        },
        "LS_AzureSQL_DB_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "sql-azde-lab-ci-001.database.windows.net"
        },
        "LS_AzureSQL_DB_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "free-sql-db-azde-lab"
        },
        "LS_AzureSQL_DB_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "azure_lab_user"
        },
        "containerUri": {
            "type": "string",
            "metadata": "URI to storage account containing linked ARM templates"
        },
        "containerSasToken": {
            "type": "string",
            "metadata": "Sas token to storage account containing linked ARM templates"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "adf-azde-lab-ci-001_ArmTemplate_0",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "AzureBlobStorage1_connectionString": {
                        "value": "[parameters('AzureBlobStorage1_connectionString')]"
                    },
                    "ls_azuresql_password": {
                        "value": "[parameters('ls_azuresql_password')]"
                    },
                    "LS_ADLSGen2_Blob_connectionString": {
                        "value": "[parameters('LS_ADLSGen2_Blob_connectionString')]"
                    },
                    "LS_AzureSQL_DB_password": {
                        "value": "[parameters('LS_AzureSQL_DB_password')]"
                    },
                    "ls_azuresql_properties_typeProperties_server": {
                        "value": "[parameters('ls_azuresql_properties_typeProperties_server')]"
                    },
                    "ls_azuresql_properties_typeProperties_database": {
                        "value": "[parameters('ls_azuresql_properties_typeProperties_database')]"
                    },
                    "ls_azuresql_properties_typeProperties_userName": {
                        "value": "[parameters('ls_azuresql_properties_typeProperties_userName')]"
                    },
                    "LS_AzureSQL_DB_properties_typeProperties_server": {
                        "value": "[parameters('LS_AzureSQL_DB_properties_typeProperties_server')]"
                    },
                    "LS_AzureSQL_DB_properties_typeProperties_database": {
                        "value": "[parameters('LS_AzureSQL_DB_properties_typeProperties_database')]"
                    },
                    "LS_AzureSQL_DB_properties_typeProperties_userName": {
                        "value": "[parameters('LS_AzureSQL_DB_properties_typeProperties_userName')]"
                    }
                }
            },
            "dependsOn": []
        },
        {
            "name": "adf-azde-lab-ci-001_ArmTemplate_1",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    }
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'adf-azde-lab-ci-001_ArmTemplate_0')]"
            ]
        }
    ]
}